{
  "title": "PR review verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "risk_tag_expected", "summary", "tests", "findings"],
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "changes_requested", "needs_human"] },
    "risk_tag_expected": { "type": "string", "enum": ["routine", "elevated", "critical"] },
    "summary": { "type": "string" },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adequate", "gaps"],
      "properties": {
        "adequate": { "type": "boolean" },
        "gaps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "title", "rationale", "suggested_fix"],
        "properties": {
          "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "title": { "type": "string" },
          "rationale": { "type": "string" },
          "suggested_fix": { "type": "string" }
        }
      }
    }
  }
}
