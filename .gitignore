# Xcode
build/
DerivedData/
*.xcuserstate
# Per-user, per-machine state. Its sibling xcshareddata/ holds the shared
# scheme every `xcodebuild -scheme` command in the README depends on; nothing
# here excludes it, so it needs no negation to stay tracked.
xcuserdata/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
*.perspectivev3
*.xcscmblueprint
timeline.xctimeline
*.hmap
*.ipa
*.dSYM.zip
# Result bundles from `xcodebuild -resultBundlePath`. They are directories,
# tens of megabytes each, and the CI job uploads them as artifacts instead.
*.xcresult

# Local agent/tool state (lock files, transcripts). Machine-specific, and
# nothing in the build or the test suite reads it. The harness pieces are
# the exception: the checked-in settings, the hook, and the skills are what
# the PR review workflow runs, so they are tracked.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store
